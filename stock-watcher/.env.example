# Telegram Settings
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Optional: Google Gemini API Key for AI Summarization
# Leave empty to get clean article alerts without AI summaries
GEMINI_API_KEY=

# Watchlist Keywords & Tickers (comma-separated)
WATCHLIST_KEYWORDS=NVDA,AAPL,TSLA,MSFT,GOOG,AMZN,META,AMD,OPENAI,ANTHROPIC,zero-day,ransomware,breach,earnings,acquisition

# Polling Interval (in minutes)
POLL_INTERVAL_MINUTES=10
