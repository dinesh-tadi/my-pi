# Argon Hub Auth & RBAC Configuration
# Generate a secure secret using: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_64_char_hex_key
JWT_EXPIRATION_DAYS=30

# Optional: initial admin password when seeding DB for the first time.
# If left empty, a secure random password will be generated and printed to container logs on first launch.
INITIAL_ADMIN_PASSWORD=replace_with_a_strong_password
ALLOW_GOOGLE_SIGNUP=true

# Optional: Google OAuth Client ID for web/mobile sign-in
GOOGLE_CLIENT_ID=
